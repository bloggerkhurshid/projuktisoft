<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow directory listing prevention without causing 403 on existing directories if index exists
  DirectoryIndex index.html

  # Handle Next.js Static Export Clean URLs
  # 1. If path is a directory and index.html exists within it, serve index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 2. If requested path with .html extension exists as a file, rewrite to path.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

