<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve index.html as default
  DirectoryIndex index.html

  # Disable Directory Indexes & MultiViews
  Options -Indexes -MultiViews

  # 1. Direct files (CSS, JS, images, SVG, txt, xml)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Direct directory requests with trailing slash (e.g. /careers/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # 3. Clean URLs without trailing slash (e.g. /careers -> /careers/index.html or /careers.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Fallback 404 for unknown URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>





