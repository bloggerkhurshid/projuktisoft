<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Prevent 403 Forbidden when directory listings are requested by setting index file
  DirectoryIndex index.html

  # Disable MultiViews to avoid conflicts with file extension matching
  Options -MultiViews

  # 1. If requesting a directory like /careers/ or /careers, serve /careers.html or /careers/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 2. If requesting a route without .html (e.g. /careers), rewrite to /careers.html if it exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>


